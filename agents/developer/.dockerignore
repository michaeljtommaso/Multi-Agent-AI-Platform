# Docker only reads the .dockerignore in the build folder (./agents/developer in
# docker-compose.yml), so the one at the repo root does not apply here.

# API keys: compose passes them in at run time through env_file, never bake them in
.env
.env.*
!.env.example

# Local virtual environments are built for this laptop, not the Linux image
.venv/
venv/

# Python and test leftovers
__pycache__/
*.pyc
.pytest_cache/

# IDE and OS files
.vscode/
.DS_Store
